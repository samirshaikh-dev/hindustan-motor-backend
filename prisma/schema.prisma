datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  EMPLOYEE
}

enum JobStatus {
  RECEIVED
  IN_PROGRESS
  TESTING
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTasks  Task[]    @relation("AssignedEmployee")
  historyActions History[] @relation("ActorEmployee")

  @@index([isActive])
  @@index([role])
}

model Motor {
  id                 String       @id @default(cuid())
  motorNumber        String       @unique
  customerName       String
  customerPhone      String
  brand              String?
  motorType          String?
  power              Float?
  powerUnit          String?      @default("HP")
  rpm                Int?
  phase              String?
  serialNumber       String?
  complaint          String?
  notes              String?
  receivedAt         DateTime     @default(now())
  expectedDeliveryAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  images    MotorImage[]
  jobs      Job[]
  histories History[]

  @@index([customerPhone])
  @@index([customerName])
  @@index([createdAt])
}

model MotorImage {
  id           String   @id @default(cuid())
  motorId      String
  publicId     String
  secureUrl    String
  resourceType String   @default("image")
  width        Int?
  height       Int?
  bytes        Int?
  format       String?
  createdAt    DateTime @default(now())

  motor Motor @relation(fields: [motorId], references: [id], onDelete: Cascade)

  @@index([motorId])
}

model Job {
  id        String    @id @default(cuid())
  jobNumber String    @unique
  motorId   String
  status    JobStatus @default(RECEIVED)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  motor     Motor     @relation(fields: [motorId], references: [id], onDelete: Cascade)
  tasks     Task[]
  histories History[]

  @@index([motorId])
  @@index([status])
  @@index([createdAt])
}

model Task {
  id                 String     @id @default(cuid())
  jobId              String
  title              String
  description        String?
  assignedEmployeeId String?
  status             TaskStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignedEmployee Employee? @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  histories        History[]

  @@index([jobId])
  @@index([assignedEmployeeId])
  @@index([status])
}

model History {
  id              String   @id @default(cuid())
  motorId         String?
  jobId           String?
  taskId          String?
  actorEmployeeId String
  action          String
  description     String?
  metadata        Json?
  createdAt       DateTime @default(now())

  motor         Motor?    @relation(fields: [motorId], references: [id], onDelete: Cascade)
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorEmployee Employee  @relation("ActorEmployee", fields: [actorEmployeeId], references: [id], onDelete: Restrict)

  @@index([motorId])
  @@index([jobId])
  @@index([taskId])
  @@index([actorEmployeeId])
  @@index([createdAt])
}

model AdminSession {
  id                String    @id @default(cuid())
  adminEmail        String
  tokenHash         String    @unique
  family            String
  isRevoked         Boolean   @default(false)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tokenHash])
  @@index([adminEmail])
  @@index([family])
}
