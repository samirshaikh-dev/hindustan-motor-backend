# Application Environment
NODE_ENV=
PORT=

# Database (Neon PostgreSQL connection string)
DATABASE_URL=

# Actor Identity Header
ACTOR_HEADER=

# Cloudinary Storage
CLOUDINARY_URL=

# CORS
CORS_ORIGIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Admin Authentication & Token Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

JWT_ACCESS_SECRET=your-secure-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-secure-refresh-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Security (optional override: defaults to secure: true in production, sameSite: lax)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
